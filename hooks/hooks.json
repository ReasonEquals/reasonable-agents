{
  "description": "reasonable-agents enforcement hooks. v0.1 ships fail-open no-op placeholders; the next release ports the real pairing-enforcement and reviewer-output-validation logic.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/adversarial-after-agent.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/reviewer-output-validator.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
